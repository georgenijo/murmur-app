+    /// Keyboard and assistive actions use the same change event as the pointer.
+    /// Controlled programmatic updates through set_value remain silent.
+    pub fn set_user_value(&mut self, value: f32, window: &mut Window, cx: &mut Context<Self>) {
+        let value = ((value / self.step).round() * self.step).clamp(self.min, self.max);
+        if value != self.value.end() {
+            self.set_value(value, window, cx);
+            cx.emit(SliderEvent::Change(self.value));
+        }
+    }
