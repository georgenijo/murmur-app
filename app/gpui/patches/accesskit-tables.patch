+// Table structure is independent of selection support. Restrict traversal to
+// rows/row groups so a nested table cannot contribute rows to its parent.
+fn is_table(node: &Node) -> bool {
+    matches!(node.role(), Role::Table | Role::Grid | Role::TreeGrid)
+}
+
+fn table_rows<'a>(node: &Node<'a>) -> Vec<Node<'a>> {
+    let mut rows = Vec::new();
+    for child in node.filtered_children(filter) {
+        match child.role() {
+            Role::Row => rows.push(child),
+            Role::RowGroup => rows.extend(table_rows(&child)),
+            _ => (),
+        }
+    }
+    rows
+}
+
+fn table_headers<'a>(node: &Node<'a>, role: Role) -> Vec<Node<'a>> {
+    table_rows(node).into_iter().flat_map(|row| {
+        row.filtered_children(filter).filter(move |cell| cell.role() == role)
+    }).collect()
+}
+
+fn cell_index(node: &Node, row: bool) -> Option<usize> {
+    if row {
+        node.data().row_index().or_else(|| node.filtered_parent(&filter)
+            .filter(|parent| parent.role() == Role::Row)
+            .and_then(|parent| parent.data().row_index()))
+    } else {
+        node.data().column_index()
+    }
+}
