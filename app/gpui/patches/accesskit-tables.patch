+/// Windowless probe of the same table projection used by the native selectors.
+#[cfg(feature = "test-support")]
+pub fn test_table(update: accesskit::TreeUpdate, target: accesskit::NodeId)
+    -> (usize, usize, usize, usize, Vec<(usize, usize)>) {
+    let tree = Tree::new(update, false);
+    let node = tree.state().node_by_tree_local_id(target, accesskit::TreeId::ROOT)
+        .expect("adapter table exists");
+    assert!(is_table(&node));
+    let rows = table_rows(&node);
+    let indices = rows.iter().flat_map(|row| row.filtered_children(filter))
+        .filter_map(|cell| Some((cell_index(&cell, true)?, cell_index(&cell, false)?)))
+        .collect();
+    (rows.len(), node.data().column_count().unwrap_or(0),
+        table_headers(&node, Role::ColumnHeader).len(),
+        table_headers(&node, Role::RowHeader).len(), indices)
+}
+
+/// Main-thread, windowless test of the actual Objective-C table selectors.
+#[cfg(feature = "test-support")]
+pub fn test_native_table(update: accesskit::TreeUpdate, target: accesskit::NodeId) {
+    use crate::context::ActionHandlerNoMut;
+    use objc2::{msg_send, rc::WeakId};
+    use objc2_foundation::MainThreadMarker;
+    struct NoActions;
+    impl ActionHandlerNoMut for NoActions {
+        fn do_action(&self, _: ActionRequest) { panic!("read-only table probe dispatched an action"); }
+    }
+    let expected = test_table(update.clone(), target);
+    let tree = Tree::new(update, false);
+    let id = tree.state().node_by_tree_local_id(target, accesskit::TreeId::ROOT).unwrap().id();
+    let context = Context::new(WeakId::default(), tree, Rc::new(NoActions),
+        MainThreadMarker::new().expect("native table probe runs on main"));
+    let table = context.get_or_create_platform_node(id);
+    unsafe {
+        for selector in [sel!(accessibilityRows), sel!(accessibilityColumns),
+            sel!(accessibilityRowCount), sel!(accessibilityColumnCount),
+            sel!(accessibilityColumnHeaderUIElements), sel!(accessibilityCellForColumn:row:)] {
+            let allowed: bool = msg_send![&*table, isAccessibilitySelectorAllowed: selector];
+            assert!(allowed);
+        }
+        let rows: Id<NSArray<PlatformNode>> = msg_send_id![&*table, accessibilityRows];
+        let columns: Id<NSArray<NSAccessibilityElement>> = msg_send_id![&*table, accessibilityColumns];
+        let headers: Id<NSArray<PlatformNode>> = msg_send_id![&*table, accessibilityColumnHeaderUIElements];
+        let row_count: NSInteger = msg_send![&*table, accessibilityRowCount];
+        let column_count: NSInteger = msg_send![&*table, accessibilityColumnCount];
+        assert_eq!((rows.len(), columns.len(), headers.len()), (expected.0, expected.1, expected.2));
+        assert_eq!((row_count as usize, column_count as usize), (expected.0, expected.1));
+        for (row, column) in expected.4 {
+            let cell: Id<PlatformNode> = msg_send_id![&*table, accessibilityCellForColumn: column as NSInteger row: row as NSInteger];
+            let row_range: NSRange = msg_send![&*cell, accessibilityRowIndexRange];
+            let column_range: NSRange = msg_send![&*cell, accessibilityColumnIndexRange];
+            assert_eq!(row_range, NSRange::new(row, 1));
+            assert_eq!(column_range, NSRange::new(column, 1));
+            let headers: Id<NSArray<PlatformNode>> = msg_send_id![&*cell, accessibilityColumnHeaderUIElements];
+            assert_eq!(headers.len(), usize::from(expected.2 > 0));
+        }
+        for (index, column) in columns.to_vec().into_iter().enumerate() {
+            let role: Id<NSString> = msg_send_id![column, accessibilityRole];
+            let actual_index: NSInteger = msg_send![column, accessibilityIndex];
+            let cells: Id<NSArray<PlatformNode>> = msg_send_id![column, accessibilityChildren];
+            assert_eq!(&*role, NSAccessibilityColumnRole);
+            assert_eq!(actual_index as usize, index);
+            assert_eq!(cells.len(), expected.0);
+        }
+        let missing: Option<Id<PlatformNode>> = msg_send_id![&*table, accessibilityCellForColumn: -1isize row: 0isize];
+        assert!(missing.is_none());
+    }
+}
