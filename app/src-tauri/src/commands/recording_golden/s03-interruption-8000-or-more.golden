# golden: s03-interruption-8000-or-more
# scenario: 3 interruption of 8,000 samples or more
# witnesses: PD-15
# lines: `~` is shared state seen to change since the previous line; `#` is a
# scenario step; everything else is a port call, an emit or a reply, in order.

=== 3a Interrupted accepted, auto-stop transcribes ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.set_phase Starting
supervisor.notify 1 Accepted
supervisor.set_phase Recording
supervisor.notify 1 Ready
supervisor.start_ack 1 Ok
smart_destination.capture enabled=false
refresh_expired_ide_context
performance.production_context 1
~ context 1 installed
publish_recording_ready 1
supervisor.is_dictation_recording 1 -> true
emit recording-status-changed "recording"
SD ticker 1 registered=true
~ status Starting -> Recording
publish_recording_ready 1 -> true
spawn_model_preparation 1
performance.spawn_begin 1
reply start Ok {"recordingId":1,"state":"starting","type":"recording_starting"}
supervisor.set_phase Recovering
supervisor.notify 1 Recovering(runtime_failure)
~ status Recording -> Recovering
emit recording-status-changed "recovering"
emit audio-recovery-started {"reason":"runtime_failure","recordingId":1}
supervisor.notify 1 Interrupted(runtime_failure, 9000 samples)
emit recording-interrupted {"actionCode":"wait_for_partial_transcription","autoTranscribe":true,"deliveredSamples":9000,"durationMs":562,"reason":"runtime_failure","recordingId":1,"statusCode":"microphone_interrupted"}
bridge.auto_stop_scheduled 1
supervisor.hold_before_owner_clear 1
supervisor.take_interrupted 1 -> 9000 samples
claim_preview_hide 1
ax.capture_delivery_target_snapshot
~ status Recovering -> Processing
keyboard.hotkey_release_take_for 1
keyboard.stop_gesture_take_for 1
keyboard.set_processing true
~ processing true
emit recording-status-changed "processing"
performance.production_sample_count 1 9000
pipeline 1 samples=9000
pipeline 1 returns
~ status Processing -> Idle
~ processing false
~ context 1 cleared
pipeline 1 idle_guard wrote_idle=true
keyboard.set_processing false
emit recording-status-changed "idle"
~ terminal 1 RuntimeInterruption/StreamInvalidated
~ perf-claim 1 {"status":"success"}
emit transcription-complete {"duration":0,"interrupted":{"deliveredSamples":9000,"durationMs":562,"reason":"stream_invalidated"},"rawText":"scripted transcript","recording":{"modelId":"base.en","profileId":null,"recordingId":1,"stages":[]},"recordingId":1,"text":"scripted transcript"}
reply auto-stop Ok {"state":"idle","text":"scripted transcript","type":"transcription"}
supervisor.clear_owner 1
supervisor.set_phase Idle
= final status=Idle processing=false context=none cancelled_through=0

=== 3b auto-stop races a user stop: the user stop wins ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.set_phase Starting
supervisor.notify 1 Accepted
supervisor.set_phase Recording
supervisor.notify 1 Ready
supervisor.start_ack 1 Ok
smart_destination.capture enabled=false
refresh_expired_ide_context
performance.production_context 1
~ context 1 installed
publish_recording_ready 1
supervisor.is_dictation_recording 1 -> true
emit recording-status-changed "recording"
SD ticker 1 registered=true
~ status Starting -> Recording
publish_recording_ready 1 -> true
spawn_model_preparation 1
performance.spawn_begin 1
reply start Ok {"recordingId":1,"state":"starting","type":"recording_starting"}
supervisor.set_phase Recovering
supervisor.notify 1 Recovering(runtime_failure)
~ status Recording -> Recovering
emit recording-status-changed "recovering"
emit audio-recovery-started {"reason":"runtime_failure","recordingId":1}
supervisor.notify 1 Interrupted(runtime_failure, 9000 samples)
emit recording-interrupted {"actionCode":"wait_for_partial_transcription","autoTranscribe":true,"deliveredSamples":9000,"durationMs":562,"reason":"runtime_failure","recordingId":1,"statusCode":"microphone_interrupted"}
bridge.auto_stop_scheduled 1
supervisor.hold_before_owner_clear 1
supervisor.take_interrupted 1 -> 9000 samples
claim_preview_hide 1
ax.capture_delivery_target_snapshot
~ status Recovering -> Processing
keyboard.hotkey_release_take_for 1
keyboard.stop_gesture_take_for 1
keyboard.set_processing true
~ processing true
emit recording-status-changed "processing"
performance.production_sample_count 1 9000
pipeline 1 samples=9000
gate pipeline wait
# user stop took the capture and is in the pipeline
reply auto-stop Ok {"state":"processing","type":"already_processing"}
gate pipeline opened
gate pipeline pass
pipeline 1 returns
~ status Processing -> Idle
~ processing false
~ context 1 cleared
pipeline 1 idle_guard wrote_idle=true
keyboard.set_processing false
emit recording-status-changed "idle"
~ terminal 1 RuntimeInterruption/StreamInvalidated
~ perf-claim 1 {"status":"success"}
emit transcription-complete {"duration":0,"interrupted":{"deliveredSamples":9000,"durationMs":562,"reason":"stream_invalidated"},"rawText":"scripted transcript","recording":{"modelId":"base.en","profileId":null,"recordingId":1,"stages":[]},"recordingId":1,"text":"scripted transcript"}
reply user stop Ok {"state":"idle","text":"scripted transcript","type":"transcription"}
supervisor.clear_owner 1
supervisor.set_phase Idle
= final status=Idle processing=false context=none cancelled_through=0

