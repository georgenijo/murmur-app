# golden: s12-start-failure-vs-initialization-failed
# scenario: 12 start failure vs InitializationFailed + Idle
# witnesses: PD-3 (S3), SP1
# lines: `~` is shared state seen to change since the previous line; `#` is a
# scenario step; everything else is a port call, an emit or a reply, in order.

=== 12a failure ack before the supervisor's failure terminal ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.notify 1 Accepted
supervisor.start_ack 1 Err(scripted start failure)
performance.begin_abort 1
emit recording-status-changed "idle"
~ status Starting -> Idle
~ terminal 1 CaptureInitFailure/RuntimeFailure
reply start Err scripted start failure
supervisor.notify 1 InitializationFailed(backend_error)
~ perf-claim 1 {"status":"failed","stage":"captureFinalization","errorCode":"audioCaptureFailed"}
emit recording-initialization-failed {"actionCode":"retry","error":"scripted initialization failure","errorKind":"backend_error","recordingId":1,"statusCode":"microphone_initialization_failed"}
supervisor.notify 1 Idle

=== 12b supervisor failure terminal before the ack ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.notify 1 Accepted
supervisor.notify 1 InitializationFailed(backend_error)
~ terminal 1 CaptureInitFailure/BackendError
emit recording-initialization-failed {"actionCode":"retry","error":"scripted initialization failure","errorKind":"backend_error","recordingId":1,"statusCode":"microphone_initialization_failed"}
supervisor.notify 1 Idle
emit recording-status-changed "idle"
~ status Starting -> Idle
supervisor.start_ack 1 Err(scripted start failure)
performance.begin_abort 1
emit recording-status-changed "idle"
reply start Err scripted start failure

=== 12c 2 s start timeout with a supervisor Cancel{User} ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.notify 1 Accepted
supervisor.notify 1 Recovering(user)
~ status Starting -> Recovering
emit recording-status-changed "recovering"
emit audio-recovery-started {"reason":"user","recordingId":1}
~ terminal 1 UserCancelledStarting/CancelledStarting
emit recording-cancelled {"recordingId":1}
supervisor.start_ack 1 Err(scripted 2 s start timeout)
performance.begin_abort 1
emit recording-status-changed "idle"
~ status Recovering -> Idle
reply start Err scripted 2 s start timeout
