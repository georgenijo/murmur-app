# golden: s10-ready-vs-context
# scenario: 10 ready vs context rendezvous, both orders
# witnesses: PD-4
# known-bad: 10c records C8's second ticker under today's behaviour; it flips only in BC-2's fix PR (C11.1)
# lines: `~` is shared state seen to change since the previous line; `#` is a
# scenario step; everything else is a port call, an emit or a reply, in order.

=== 10a context first, then Ready (R207.5) ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.set_phase Starting
supervisor.notify 1 Accepted
supervisor.hold_before_ready 1
supervisor.start_ack 1 Ok
smart_destination.capture enabled=false
refresh_expired_ide_context
performance.production_context 1
~ context 1 installed
publish_recording_ready 1
supervisor.is_dictation_recording 1 -> false
publish_recording_ready 1 -> false
spawn_model_preparation 1
performance.spawn_begin 1
reply start Ok {"recordingId":1,"state":"starting","type":"recording_starting"}
# the context is installed and the command has returned; Ready arrives now
supervisor.release_ready 1
supervisor.set_phase Recording
supervisor.notify 1 Ready
emit recording-status-changed "recording"
~ status Starting -> Recording
SD ticker 1 registered=true
= final status=Recording processing=false context=1 cancelled_through=0

=== 10b Ready first, then context ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.set_phase Starting
supervisor.notify 1 Accepted
supervisor.set_phase Recording
supervisor.notify 1 Ready
supervisor.start_ack 1 Ok
smart_destination.capture enabled=false
refresh_expired_ide_context
performance.production_context 1
~ context 1 installed
publish_recording_ready 1
supervisor.is_dictation_recording 1 -> true
emit recording-status-changed "recording"
SD ticker 1 registered=true
~ status Starting -> Recording
publish_recording_ready 1 -> true
spawn_model_preparation 1
performance.spawn_begin 1
reply start Ok {"recordingId":1,"state":"starting","type":"recording_starting"}
= final status=Recording processing=false context=1 cancelled_through=0

=== 10c C8 forced (C9.5), known-bad ===
mic_transition
keyboard.is_app_disabled
supervisor.is_dictation_cleanup_pending 0 -> false
~ recording_id 0 -> 1
ax.capture_delivery_target_snapshot
~ status Idle -> Starting
emit dictation-generation-started {"recordingId":1}
emit recording-status-changed "starting"
performance.register_production 1 SystemDefault
performance.begin_register 1
supervisor.start 1 toggle
supervisor.set_phase Starting
supervisor.notify 1 Accepted
supervisor.set_phase Recording
supervisor.hold_before_ready 1
supervisor.start_ack 1 Ok
smart_destination.capture enabled=false
refresh_expired_ide_context
performance.production_context 1
~ context 1 installed
publish_recording_ready 1
supervisor.is_dictation_recording 1 -> true
emit recording-status-changed "recording"
SD ticker 1 registered=true
~ status Starting -> Recording
publish_recording_ready 1 -> true
spawn_model_preparation 1
performance.spawn_begin 1
reply start Ok {"recordingId":1,"state":"starting","type":"recording_starting"}
# observable: the status emit `recording` is in the trace above
supervisor.release_ready 1
supervisor.notify 1 Ready
SD ticker 1 registered=true
# Ready was handled; now the recording runs to Success
claim_preview_hide 1
ax.capture_delivery_target_snapshot
~ status Recording -> Processing
keyboard.hotkey_release_take_for 1
keyboard.stop_gesture_take_for 1
keyboard.set_processing true
~ processing true
emit recording-status-changed "processing"
supervisor.stop 1 Other
supervisor.set_phase Stopping
supervisor.sealed_delivery 1 samples=16000
performance.production_sample_count 1 16000
pipeline 1 samples=16000
pipeline 1 returns
~ status Processing -> Idle
~ processing false
~ context 1 cleared
pipeline 1 idle_guard wrote_idle=true
keyboard.set_processing false
emit recording-status-changed "idle"
~ terminal 1 Success/None
~ perf-claim 1 {"status":"success"}
emit transcription-complete {"duration":1,"interrupted":null,"rawText":"scripted transcript","recording":{"modelId":"base.en","profileId":null,"recordingId":1,"stages":[]},"recordingId":1,"text":"scripted transcript"}
reply stop Ok {"state":"idle","text":"scripted transcript","type":"transcription"}
# end of run: the supervisor finishes the sealed stop
supervisor.clear_owner 1
supervisor.set_phase Idle
supervisor.notify 1 CleanupFinished
emit recording-cleanup-finished {"recordingId":1}
emit recording-status-changed "idle"
= final status=Idle processing=false context=none cancelled_through=0
